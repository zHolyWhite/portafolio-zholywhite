{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend GraphQL con Fastify y Prisma",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate --schema=../database/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=../database/schema.prisma",
    "prisma:studio": "prisma studio --schema=../database/schema.prisma"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@fastify/cors": "^11.3.0",
    "@prisma/client": "^6.16.0",
    "discord.js": "^14.27.0",
    "fastify": "^5.12.1",
    "graphql": "^16.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prisma": "^6.16.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
