---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'zHolyWhite | Portafolio',
  description = 'Portafolio de zHolyWhite, Full Stack Developer, Minecraft Developer y Project Manager.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content={description} />

    <meta name="theme-color" content="#101215" />

    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>