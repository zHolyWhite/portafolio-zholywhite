---
const githubUsername = 'zHolyWhite';
const avatarUrl = `https://github.com/${githubUsername}.png`;
---

<section class="profile" aria-labelledby="profile-title">
  <div class="profile__avatar-wrapper">
    <div class="profile__glow"></div>

    <img
      src={avatarUrl}
      alt="Avatar de GitHub de zHolyWhite"
      class="profile__avatar"
      width="200"
      height="200"
    />
  </div>

  <div class="profile__details">
    <h1 id="profile-title" class="font-minecraft">
      zHolyWhite
    </h1>

    <p class="font-manrope">
      Full Stack Developer - Minecraft Developer - Project Manager
    </p>
  </div>
</section>