---
const githubUsername = 'zHolyWhite';
const githubUrl = `https://github.com/${githubUsername}`;
---

<a
  href={githubUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="github-stats"
  aria-label="Abrir el perfil de GitHub de zHolyWhite"
>
  <div class="github-stats__heading">
    <svg
      class="github-stats__icon"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
      />
    </svg>

    <span id="github-login" class="font-manrope">
      zHolyWhite
    </span>
  </div>

  <p id="github-bio" class="github-stats__bio">
    Cargando información de GitHub...
  </p>

  <div class="github-stats__metrics">
    <span>
      <strong id="github-followers">—</strong>
      seguidores
    </span>

    <span>
      <strong id="github-repositories">—</strong>
      repositorios
    </span>
  </div>
</a>

<script>
  async function loadGitHubStats() {
    try {
      const response = await fetch(
        'https://api.github.com/users/zHolyWhite',
      );

      if (!response.ok) {
        throw new Error('No se pudo consultar la API de GitHub');
      }

      const data = await response.json();

      const login = document.getElementById('github-login');
      const bio = document.getElementById('github-bio');
      const followers = document.getElementById('github-followers');
      const repositories = document.getElementById('github-repositories');

      if (login) {
        login.textContent = data.login || 'zHolyWhite';
      }

      if (bio) {
        bio.textContent = data.bio || 'Desarrollador de software';
      }

      if (followers) {
        followers.textContent = data.followers ?? '0';
      }

      if (repositories) {
        repositories.textContent = data.public_repos ?? '0';
      }
    } catch (error) {
      console.error('Error al cargar GitHub:', error);

      const bio = document.getElementById('github-bio');

      if (bio) {
        bio.textContent = 'GitHub: zHolyWhite';
      }
    }
  }

  loadGitHubStats();
</script>